[Unit]
Description=Ofelia — mesure la durée des blocages de la carte SD
# Démarrer tôt : les blocages surviennent pendant la tempête du démarrage,
# c'est-à-dire exactement quand on veut mesurer.
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/opt/edubox/scripts/sd-stall-watch.py
Restart=always
RestartSec=10
# Il échantillonne /proc une fois par seconde et n'écrit qu'à la fin d'un
# blocage : le coût est négligeable, mais autant le rendre explicite.
Nice=5
IOSchedulingClass=idle
MemoryMax=64M

[Install]
WantedBy=multi-user.target
