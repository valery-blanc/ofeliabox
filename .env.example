# /opt/edubox/.env — EXEMPLE
#
# CHANGER TOUS CES MOTS DE PASSE AVANT DÉPLOIEMENT.
# Copier en .env, remplacer chaque CHANGE_ME_*, puis : chmod 600 .env
#
# Les deux chemins d'installation normaux écrivent ce fichier eux-mêmes, avec
# des valeurs aléatoires — ce gabarit ne sert qu'à l'installation manuelle :
#   - l'assistant de premier démarrage  → setup/app.py::_write_env
#   - le script d'installation Pi neuf  → scripts/install.sh
#
# ⚠️ La liste ci-dessous doit rester alignée sur ces deux sources ET sur les
# variables consommées par docker-compose.yml. Une clé manquante ne provoque
# aucune erreur visible : Compose substitue une chaîne VIDE. Concrètement, une
# Box installée à la main avec l'ancien gabarit (6 clés sur 18) démarrait avec
# Redis refusant `--requirepass ''`, Django refusant `SECRET_KEY=''`, et les
# comptes admin de Koha, PMB et SLiMS initialisés sans mot de passe.

# ─── Identité de la Box ───────────────────────────────────────────────────────
BOX_NAME=Ofelia

# ─── Point d'accès Wi-Fi ──────────────────────────────────────────────────────
AP_PASS=CHANGE_ME_ap

# ─── MariaDB (partagée : Moodle, Koha, PMB, SLiMS) ────────────────────────────
MARIADB_ROOT_PASS=CHANGE_ME_root

# ─── Moodle ───────────────────────────────────────────────────────────────────
MOODLE_DB_PASS=CHANGE_ME_moodle_db
MOODLE_ADMIN_PASS=CHANGE_ME_moodle_admin

# ─── Koha (+ SIP2) ────────────────────────────────────────────────────────────
KOHA_DB_PASS=CHANGE_ME_koha_db
KOHA_ADMIN_PASS=CHANGE_ME_koha_admin
SIP2_GATE_PASS=CHANGE_ME_gate
SIP2_SELFCHECK_PASS=CHANGE_ME_selfcheck

# ─── PMB ──────────────────────────────────────────────────────────────────────
PMB_DB_PASS=CHANGE_ME_pmb_db
PMB_ADMIN_PASS=CHANGE_ME_pmb_admin

# ─── SLiMS ────────────────────────────────────────────────────────────────────
SLIMS_DB_PASS=CHANGE_ME_slims_db
SLIMS_ADMIN_PASS=CHANGE_ME_slims_admin

# ─── Calibre-Web ──────────────────────────────────────────────────────────────
CALIBRE_ADMIN_PASS=CHANGE_ME_calibre

# ─── Digistorm (+ Redis) ──────────────────────────────────────────────────────
REDIS_PASS=CHANGE_ME_redis
DIGISTORM_SESSION_KEY=CHANGE_ME_session

# ─── BibliOfelia ──────────────────────────────────────────────────────────────
# Django refuse de démarrer si cette clé est vide. 50 caractères aléatoires.
BIBLIOFELIA_SECRET_KEY=CHANGE_ME_bibliofelia_secret
# Facultatif : origines supplémentaires pour la protection CSRF derrière nginx,
# séparées par des virgules (ex. https://canaima.bibliofelia.org).
BIBLIOFELIA_CSRF_TRUSTED_ORIGINS=
