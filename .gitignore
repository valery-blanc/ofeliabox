# Secrets — ne jamais versionner
.env
*.env

# Logs
*.log
logs/

# Backups
*.sql
*.sql.gz
*.mbz

# Docker volumes (sur le Pi)
data/

# Fichiers ZIM (multi-Go, téléchargés à l'installation)
kiwix/data/*.zim
kiwix/data/*.zim.tmp

# Credentials générés par le setup wizard (contient des mots de passe)
portal/credentials-data.json

# Backups auto
docker-compose.yml.bak

# Python
__pycache__/
*.pyc
*.pyo

# Temporaire
temp*.txt
mdp.txt

# macOS
.DS_Store

# Windows
Thumbs.db
.claude/

# Cle de session du portail dadmin — secret, propre a chaque Box
.admin-session-key

# Sauvegardes horodatees creees par les scripts de patch
*.bak-*
portal/.ofelia-secrets.json

# ─── État produit par la Box en fonctionnement (2026-09-11) ──────────────────
# Ces fichiers sont réécrits en continu par la Box elle-même. Versionnés, ils
# rendraient l'arbre de travail perpétuellement sale et feraient conclure à tort
# qu'un déploiement a modifié du code.
portal/boot-status.json
portal/sd-health.json
portal/wizard-state.json

# ─── Copies de travail laissées sur la Box ──────────────────────────────────
# Reliquats de dépannage, présents dans /opt/edubox mais qui ne sont le code de
# personne : gabarit de l'assistant d'avant le durcissement (1144 lignes contre
# 2406), doublons de populate_books.py, sauvegardes manuelles.
*.bak
setup/index.html
setup/populate_books.py
scripts/populate_books.py
